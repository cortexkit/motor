#!/bin/sh
# PID 1 first makes the read-only disk writable through a private RAM overlay.
set -eu
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o size=1G,mode=0700,nodev,nosuid tmpfs /overlay
mkdir /overlay/upper /overlay/work /overlay/root
mount -t overlay -o lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work overlay /overlay/root
cd /overlay/root
pivot_root . .lower
cd /
mount --move /.lower/proc /proc
mount --move /.lower/sys /sys
mount --move /.lower/dev /dev
mount --move /.lower/overlay /overlay
exec /sbin/init "$@"
