[Unit]
Description=Private x86_64 Windows evaluation build VM
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/build/windows-vm /srv/build/motor-windows

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=kvm
WorkingDirectory=/srv/build/windows-vm
ExecStart=/srv/build/windows-vm/provision/launch.sh
# Request ACPI shutdown first. A stop timeout is not a clean snapshot boundary.
ExecStop=/usr/bin/python3 /srv/build/windows-vm/provision/control.py shutdown
TimeoutStopSec=180
Restart=no
UMask=0077
CPUAffinity=12 13 14 15
CPUQuota=400%
CPUWeight=10
Nice=10
IOWeight=10
MemoryMax=18G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/build/windows-vm /srv/build/motor-windows/slot.lock
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
