[Unit]
Description=CortexKit motor-runner (exec-remote/v1 runner, instance main)

[Service]
# Requires the operator's user@UID.service drop-in installed by install-units.sh.
OOMScoreAdjust=-900
# A killed setup/launcher child must not stop the control-plane service.
OOMPolicy=continue
Environment=HOME=/home/ubuntu
Environment=CARGO_HOME=/srv/build/cargo-home
Environment=RUSTUP_HOME=/home/ubuntu/.rustup
Environment=PATH=/srv/build/cargo-home/bin:/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.cargo/bin/motor-runner serve --instance main --max-weight 96 --job-network veth --windows-cpus 12-15 --windows-slot-lock /srv/build/motor-windows/slot.lock --remote-cache true --caller-root /home=/srv/build/callers/main/home --build-folder-cap-bytes 68719476736
Restart=on-failure
RestartSec=2
KillMode=mixed

[Install]
WantedBy=default.target
