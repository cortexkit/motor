[Unit]
Description=Motor runner in a single-tenant Boat sandbox
Requires=motor-boat-restored.service motor-boat-storage.service
After=network-online.target motor-boat-restored.service motor-boat-storage.service

[Service]
OOMScoreAdjust=-900
OOMPolicy=continue
User=root
Group=root
RuntimeDirectory=motor-tenant
RuntimeDirectoryMode=0700
Environment=HOME=/home/ubuntu
Environment=CARGO_HOME=/srv/build/cargo-home
Environment=RUSTUP_HOME=/home/ubuntu/.rustup
Environment=PATH=/home/ubuntu/.bun/bin:/srv/build/cargo-home/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=TMPDIR=/var/lib/motor-boat/tmp
UnsetEnvironment=ASCII_TOKEN BOAT_ID BOAT_CLI_TOKEN BOAT_CURRENT_ID_FILE
ExecStartPre=+/usr/bin/python3 /usr/local/libexec/motor-boat-credentials.py --output /run/motor-boat-credentials.json
ExecStartPre=+/usr/local/libexec/motor-boat-network
ExecStart=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py serve --boat-profile --tenant-vm --tenant-socket-dir /run/motor-tenant --reserve-daemon-core false --free-space-floor-bytes 34426847232 --free-space-eviction-bytes 42949672960 --backend host --instance boat --state-root /var/lib/motor-boat/state --build-slot-root /var/lib/motor-boat/slots --sccache-size-gib 8 --job-network veth --remote-cache true
ExecStartPost=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py --wait-ready
TimeoutStartSec=300
Restart=on-failure
RestartSec=2
KillMode=mixed

[Install]
WantedBy=multi-user.target
