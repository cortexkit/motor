[Unit]
Description=Motor runner in a single-tenant Boat sandbox
Requires=Users.mount var-lib-motor\x2dboat.mount
After=Users.mount var-lib-motor\x2dboat.mount network-online.target

[Service]
User=motor-boat
Group=motor-boat
Environment=HOME=/var/lib/motor-boat/home
Environment=CARGO_HOME=/srv/build/cargo-home
Environment=RUSTUP_HOME=/home/ubuntu/.rustup
Environment=PATH=/srv/build/cargo-home/bin:/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=/var/lib/motor-boat/tmp
UnsetEnvironment=ASCII_TOKEN BOAT_ID BOAT_CLI_TOKEN
ExecStartPre=+/usr/local/libexec/motor-boat-network
ExecStart=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py serve --boat-profile --backend host --instance boat --state-root /var/lib/motor-boat/state --build-slot-root /var/lib/motor-boat/slots --max-weight @VCPUS@ --rustc-slots @VCPUS@ --sccache-size-gib 8 --job-network veth
ExecStartPost=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py --wait-ready
Restart=on-failure
RestartSec=2
KillMode=mixed

[Install]
WantedBy=multi-user.target
