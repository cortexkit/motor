[Unit]
Description=Motor token-checking endpoint in a Boat sandbox
Requires=motor-boat.service motor-boat-restored.service motor-boat-storage.service Users.mount var-lib-motor\x2dboat.mount
After=motor-boat.service motor-boat-restored.service motor-boat-storage.service Users.mount var-lib-motor\x2dboat.mount
ConditionPathExists=/etc/motor/tenant/id
# Keep restarting after failures; the broker waits for the readiness marker.
StartLimitIntervalSec=0

[Service]
User=root
Group=root
Environment=HOME=/var/lib/motor-boat/home
UnsetEnvironment=ASCII_TOKEN BOAT_ID BOAT_CLI_TOKEN BOAT_CURRENT_ID_FILE
# /run/motor holds endpoint-ready (written by motor-host once it listens with
# broker keys loaded) and endpoint-revision; systemd removes it on stop.
RuntimeDirectory=motor
RuntimeDirectoryMode=0755
ExecStartPre=-/usr/bin/install -m 0644 /etc/motor/image-revision /run/motor/endpoint-revision
ExecStart=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py --host-exec --sandbox /etc/motor/sandbox.json
ExecStartPost=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py --wait-host-ready
TimeoutStartSec=300
Restart=on-failure
RestartSec=2
