[Unit]
Description=Motor token-checking endpoint in a Boat sandbox
Requires=motor-boat.service
After=motor-boat.service
ConditionPathExists=/etc/motor/tenant/id

[Service]
User=root
Group=root
Environment=HOME=/var/lib/motor-boat/home
UnsetEnvironment=ASCII_TOKEN BOAT_ID BOAT_CLI_TOKEN
ExecStart=/usr/local/bin/motor-host --sandbox /etc/motor/sandbox.json
ExecStartPost=/usr/bin/python3 /usr/local/libexec/motor-boat-start.py --wait-host-ready
Restart=on-failure
RestartSec=2
