#!/usr/bin/env python3
"""Reapply only motor's egress table when a Boat machine starts or resumes."""
import json
from pathlib import Path
import re
import subprocess


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


routes = json.loads(run("ip", "-j", "-4", "route", "show", "default", capture_output=True).stdout)
if not routes or not re.fullmatch(r"[a-zA-Z0-9_.-]+", routes[0]["dev"]):
    raise SystemExit("no verified IPv4 egress interface; refusing outbound job networking")
interface = routes[0]["dev"]
rules = Path("/usr/local/libexec/motor-boat-net.nft").read_text()
if rules.count("enp6s0") != 3:
    raise SystemExit("unexpected motor network template")
exists = subprocess.run(["nft", "list", "table", "inet", "motor_net"], capture_output=True).returncode == 0
transaction = ("delete table inet motor_net\n" if exists else "") + rules.replace("enp6s0", interface)
run("nft", "-f", "-", input=transaction)
run("sysctl", "-w", "net.ipv4.ip_forward=1")
run("ufw", "route", "allow", "in", "on", "mnet-+", "out", "on", interface, "from", "10.88.0.0/16")
meminfo = Path('/proc/meminfo').read_text()
available = next(int(line.split()[1]) * 1024 for line in meminfo.splitlines() if line.startswith('MemAvailable:'))
Path('/run/motor-boat-memory.json').write_text(json.dumps({'meminfo_before_runner': meminfo,
    'mem_available_bytes': available, 'nproc': run('nproc', capture_output=True).stdout.strip()}) + '\n')
