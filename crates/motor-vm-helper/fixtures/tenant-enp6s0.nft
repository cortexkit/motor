add table inet motor_tenant
add set inet motor_tenant tenant_taps { type ifname; }
add set inet motor_tenant closed_taps { type ifname; }
flush set inet motor_tenant tenant_taps
add element inet motor_tenant tenant_taps { "mtap1" }
flush set inet motor_tenant closed_taps
add set inet motor_tenant non_public_v4 { type ipv4_addr; flags interval; }
flush set inet motor_tenant non_public_v4
add element inet motor_tenant non_public_v4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24, 192.168.0.0/16, 192.175.48.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
add chain inet motor_tenant tenant_guard_input { type filter hook input priority -20; policy accept; }
add rule inet motor_tenant tenant_guard_input iifname "mtap*" counter drop
add chain inet motor_tenant tenant_guard_forward { type filter hook forward priority -20; policy accept; }
add rule inet motor_tenant tenant_guard_forward iifname @closed_taps counter drop
add rule inet motor_tenant tenant_guard_forward oifname @closed_taps counter drop
add rule inet motor_tenant tenant_guard_forward iifname "mtap*" iifname != @tenant_taps counter drop
add rule inet motor_tenant tenant_guard_forward oifname "mtap*" oifname != @tenant_taps counter drop
add counter inet motor_tenant tenant_mtap1_egress { }
add chain inet motor_tenant tenant_mtap1_input { type filter hook input priority -10; policy accept; }
add rule inet motor_tenant tenant_mtap1_input iifname "mtap1" counter drop comment "tenant_host"
add chain inet motor_tenant tenant_mtap1_forward { type filter hook forward priority -10; policy accept; }
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" oifname "mtap*" counter drop comment "tenant_taps"
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" meta nfproto ipv6 counter drop comment "tenant_ipv6"
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" fib daddr type local counter drop comment "tenant_host"
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" ip daddr @non_public_v4 counter drop comment "tenant_private"
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" ip saddr != 10.200.1.2 counter drop comment "tenant_source"
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" oifname "enp6s0" meta nfproto ipv4 ip saddr 10.200.1.2 ct state new,established,related counter name tenant_mtap1_egress accept comment "tenant_public"
add rule inet motor_tenant tenant_mtap1_forward oifname "mtap1" iifname "enp6s0" meta nfproto ipv4 ip daddr 10.200.1.2 ct state established,related counter accept
add rule inet motor_tenant tenant_mtap1_forward oifname "mtap1" counter drop comment "tenant_inbound"
add rule inet motor_tenant tenant_mtap1_forward iifname "mtap1" counter drop comment "tenant_unmatched"
add chain inet motor_tenant tenant_mtap1_nat { type nat hook postrouting priority srcnat; policy accept; }
add rule inet motor_tenant tenant_mtap1_nat iifname "mtap1" oifname "enp6s0" ip saddr 10.200.1.2 counter masquerade
