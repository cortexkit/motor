[Unit]
Description=Motor microVM privilege and slot-lease helper
After=local-fs.target motor-vm-storage-private.service
Requires=motor-vm-storage-private.service
RequiresMountsFor=/var/lib/motor-vm

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/motor-vm-helper --config /etc/motor-vm-helper.json
Restart=on-failure
RestartSec=1
Delegate=yes
DelegateSubgroup=helper
# Tenant VMs run in this unit's cgroup. SIGTERM goes only to the helper, which
# stops each running tenant cleanly (guest drain, sync and freeze, then the
# VMM) and exits. systemd then SIGKILLs whatever is left in the cgroup: job
# VMs, and any tenant the helper recorded as unclean.
KillMode=mixed
# The helper serves one request at a time. Shutdown may first wait for one
# tenant's in-flight stop or suspend, whose host reply budget is 600 s. It then
# cleanly stops the remaining tenant: prepare allows 400 s including relay,
# drain, a dirty-page flush capped at 300 s, and freeze. Allow another 20 s for
# Firecracker exit and helper cleanup. The 1020 s total covers that one-tenant
# shutdown without systemd SIGKILLing a stop still in flight. Add 420 s for each
# further running tenant. Past this bound, systemd SIGKILLs what remains and
# the next tenant boot performs recovery.
TimeoutStopSec=1020
UMask=0022
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
